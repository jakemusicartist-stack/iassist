{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,

  "name": "Iassist for Instagram",
  "description": "Iassist: The ultimate macOS-inspired Instagram Assistant.",
  "version": "1.0.0",

  "icons": {
    "16": "img/icon-16.png",
    "128": "img/icon-128.png",
    "500": "img/icon-500.png"
  },

  "background": {
    "service_worker": "/app/bg.js"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },

  "content_scripts": [
    {
      "matches": ["https://*.instagram.com/*"],
      "js": ["/app/cs.js", "/app/instagram-plus.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "permissions": [
    "alarms",
    "background",
    "cookies",
    "declarativeNetRequest",
    "offscreen",
    "unlimitedStorage"
  ],
  "optional_permissions": ["downloads", "downloads.ui"],

  "host_permissions": ["*://*.instagram.com/*"],
  "optional_host_permissions": ["*://*.fbcdn.net/*", "*://*.cdninstagram.com/*"],

  "action": {
    "default_icon": { "48": "img/icon-badge-48.png" },
    "default_title": "Iassist for Instagram"
  },

  "web_accessible_resources": [
    {
      "resources": ["/*"],
      "matches": ["*://*.instagram.com/*"]
    }
  ]
}
